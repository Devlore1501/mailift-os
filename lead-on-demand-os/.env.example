# Database: Postgres in produzione/sviluppo, pglite per demo senza server
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/lod_dev
# DATABASE_URL=pglite://./.data/lod

# API
PORT=4000
HOST=0.0.0.0
JWT_SECRET=cambiami-in-produzione
JWT_TTL_SECONDS=43200
CORS_ORIGIN=http://localhost:3000
AUTO_DELIVER_ON_ASSIGN=true
WORKER_INTERVAL_MS=5000

# Chiave per POST /leads da landing page, Make, Zapier (header x-api-key)
PUBLIC_LEAD_API_KEY=

# GoHighLevel (LeadConnector v2). Token globale opzionale: i clienti possono avere un'integrazione propria.
GHL_API_KEY=
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
# Segreto atteso in header x-webhook-secret (o ?secret=) su POST /webhooks/ghl
GHL_WEBHOOK_SECRET=

# Notifiche esterne (opzionale)
SLACK_WEBHOOK_URL=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

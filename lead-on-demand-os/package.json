{
  "name": "lead-on-demand-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @lod/api dev",
    "dev:web": "pnpm --filter @lod/web dev",
    "db:generate": "pnpm --filter @lod/db generate",
    "db:migrate": "pnpm --filter @lod/db migrate",
    "db:seed": "pnpm --filter @lod/db seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "vitest": "^3.2.4"
  }
}

   "module": "gateway:CustomWebHook",
   "version": 1,
   "parameters": {
    "hook": null,
    "maxResults": 1
   },
   "mapper": {},
   "metadata": {
    "designer": {
     "x": -300,
     "y": 0,
     "name": "GHL -> lead da ricercare"
    },
    "restore": {
     "parameters": {
      "hook": {
       "data": {
        "editable": "true"
       },
       "label": "mailift-lead-precall-research"
      }
     }
    },
    "parameters": [
     {
      "name": "hook",
      "type": "hook:gateway-webhook",
      "label": "Webhook",
      "required": true
     },
